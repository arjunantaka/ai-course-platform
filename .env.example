# Provider AI: endpoint OpenAI-compatible (mis. 9router). Wajib di-set.
AI_BASE_URL=https://9router.local/v1
AI_API_KEY=your-key-here
# Tier planner: keputusan struktur (kategorisasi + review outline). Model berat.
AI_MODEL_PLANNER=bd/zai-org/GLM-5.3
# Tier text: penulisan materi lesson + kuis. Model cepat.
AI_MODEL_TEXT=bd/zai-org/GLM-5.3-Flash

# Token rahasia untuk masuk /admin (WAJIB diganti di produksi)
ADMIN_TOKEN=change-me

# Opsional
DB_PATH=./data/krascourse.db
PORT=3000
HOST=127.0.0.1
# Origin server (wajib untuk validasi CSRF form di production, harus cocok dengan HOST/PORT)
ORIGIN=http://127.0.0.1:3000
